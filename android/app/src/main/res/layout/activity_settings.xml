<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Las metas se comparan con cada oferta. La gasolina se descuenta del bruto."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_meta_hora"
            android:textColor="@color/text" />

        <EditText
            android:id="@+id/etMetaHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:hint="30000"
            android:inputType="number"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_meta_km"
            android:textColor="@color/text" />

        <EditText
            android:id="@+id/etMetaKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:hint="2000"
            android:inputType="number"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_galon"
            android:textColor="@color/text" />

        <EditText
            android:id="@+id/etGalon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:hint="16000"
            android:inputType="number"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_rendimiento"
            android:textColor="@color/text" />

        <EditText
            android:id="@+id/etRendimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:hint="40"
            android:inputType="numberDecimal"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swRecogida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_recogida"
            android:textColor="@color/text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccesibilidadAyuda"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_accessibility" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
